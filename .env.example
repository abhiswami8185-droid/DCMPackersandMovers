# ==============================================================================
# DCM PACKERS & MOVERS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template demonstrates the configuration separation between the current
# Client Demo (GitHub Pages / Local) and Future Client Production (Client Firebase).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT DEMO CONFIGURATION (CURRENT GITHUB PAGES DEMO / LOCAL PREVIEW)
# ------------------------------------------------------------------------------
# In demo mode, the application uses local state-backed mock providers.
# No Firebase account, project, credentials, or network calls are required.
VITE_APP_BACKEND_PROVIDER="mock"

# Base path for routing/assets. Defaults to '/DCMPackersandMovers/' for GitHub Pages
# production builds, or '/' for local development.
VITE_BASE_PATH="/DCMPackersandMovers/"

# Optional Gemini AI assistance key (handled securely server-side if present)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. FUTURE CLIENT PRODUCTION CONFIGURATION (CLIENT-OWNED FIREBASE PROJECT)
# ------------------------------------------------------------------------------
# When DCM provides their official Google Cloud / Firebase project credentials,
# set VITE_APP_BACKEND_PROVIDER to "firebase" and populate these variables.
# Do NOT enter personal credentials here. Use client-owned resources only.

# VITE_APP_BACKEND_PROVIDER="firebase"
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="dcm-packers-movers.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="dcm-packers-movers"
# VITE_FIREBASE_STORAGE_BUCKET="dcm-packers-movers.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# Client Production Payment Gateway (Razorpay India)
# VITE_RAZORPAY_KEY_ID="rzp_live_..."
