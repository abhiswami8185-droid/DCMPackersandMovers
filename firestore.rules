rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role in [
          'super_admin', 'admin', 'operations_manager', 'sales_manager',
          'survey_manager', 'surveyor', 'packing_supervisor', 'packing_staff',
          'dispatch_manager', 'delivery_staff', 'accounts', 'customer_support'
        ]
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role in ['super_admin', 'admin', 'operations_manager']
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isStaff() || isOwner(userId);
      allow create: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isSuperAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }

    // 2. Bookings & Move Specifications (Authoritative Move Lifecycle)
    match /bookings/{bookingId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() || isStaff();
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid &&
        // Customer can only update customer-action fields or review comments
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerActionRequired', 'customerRemarks'])
      );
      allow delete: if isSuperAdmin();
    }

    // 3. Quotations
    match /quotes/{quoteId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if true; // Public quote inquiry generation
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'changeRequestNotes'])
      );
      allow delete: if isSuperAdmin();
    }

    // 4. Leads CRM
    match /leads/{leadId} {
      allow read, update, delete: if isStaff();
      allow create: if true; // Public website enquiry forms
    }

    // 5. Pre-move Surveys
    match /surveys/{surveyId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() || isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // 6. Payments & Invoices
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create, update: if isStaff() || (isAuthenticated() && request.resource.data.customerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // 7. Customer Support Tickets
    match /supportTickets/{ticketId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerEmail == request.auth.token.email);
      allow create: if isAuthenticated();
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
      );
      allow delete: if isAdmin();
    }

    // 8. Damage Claims
    match /claims/{claimId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff(); // Only claims managers / admin can approve/settle
      allow delete: if isSuperAdmin();
    }

    // 9. Vehicles & Fleet Management
    match /vehicles/{vehicleId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 10. Warehouses & Storage Facilities
    match /warehouses/{warehouseId} {
      allow read: if true; // Public facility locations can be read
      allow write: if isAdmin();
    }

    // 11. Immutable Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff() || isAuthenticated();
      allow update, delete: if false; // Audit logs can NEVER be modified or deleted
    }

    // 12. Public Website CMS Content
    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
